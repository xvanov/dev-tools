#!/usr/bin/env python3
"""gh shim: choose the GitHub token by repo owner, then exec the real gh.

``factory.gh_auth.install_shim_on_path()`` puts this directory first on PATH,
so every ``gh`` the factory or its agent sessions run is routed here. The repo
is taken from ``--repo/-R``, an ``api repos/<o>/<r>/...`` path, a positional
``owner/name`` for ``repo`` verbs, else ``origin`` of the cwd checkout. If the
owner needs a pinned identity (see factory/gh_auth.py) ``GH_TOKEN`` is set for
the child only; otherwise gh runs untouched with its active account. The
active account is never switched. Tokens are never printed.
"""

import importlib.util
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKIP = {"auth", "config", "extension", "alias", "completion", "version", "help"}


def _load_auth():
    spec = importlib.util.spec_from_file_location("_factory_gh_auth", HERE.parent / "factory" / "gh_auth.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _real_gh() -> str | None:
    clean = os.pathsep.join(
        p for p in os.environ.get("PATH", "").split(os.pathsep)
        if p and Path(p).resolve() != HERE
    )
    return shutil.which("gh", path=clean)


def _repo_from_args(args: list[str], auth) -> str | None:
    for i, a in enumerate(args):
        if a in ("--repo", "-R") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--repo="):
            return a.split("=", 1)[1]
    if args and args[0] == "api":
        for a in args[1:]:
            m = re.match(r"^/?repos/([^/]+/[^/?]+)", a)
            if m:
                return m.group(1)
    if args and args[0] == "repo":
        for a in args[2:]:
            if not a.startswith("-") and auth.repo_owner(a):
                return a
    return None


def main() -> int:
    real = _real_gh()
    if real is None:
        sys.stderr.write("gh shim: real gh not found on PATH\n")
        return 127
    args = sys.argv[1:]
    env = os.environ.copy()
    if args and args[0] not in SKIP and not args[0].startswith("-"):
        try:
            auth = _load_auth()
            repo = _repo_from_args(args, auth) or auth.repo_from_cwd()
            if repo and auth.is_pinned(repo):
                tok = auth.token_for_repo(repo, gh_bin=real)
                if tok:
                    env["GH_TOKEN"] = tok
                    env.pop("GITHUB_TOKEN", None)
                else:
                    sys.stderr.write(
                        "gh shim: no token for pinned owner of %s; "
                        "run `gh auth login` for the mapped account\n" % repo
                    )
        except Exception as exc:  # never break gh because the shim failed
            sys.stderr.write("gh shim: resolver error (%s); using default auth\n" % type(exc).__name__)
    if os.name == "posix":
        os.execve(real, [real, *args], env)
    return subprocess.run([real, *args], env=env).returncode


if __name__ == "__main__":
    sys.exit(main())
