[Unit]
Description=Factory serve: ticks the opted-in apps (serve_tick: true), JOBS-API on 127.0.0.1:7330, pushes job states to the PA
# Replaces the factory-tick@<app>.timer units (plan 2.2). Serve refuses to run
# while any of them is active: `factory off` (or disable the timers) first.
After=network-online.target

[Service]
Type=simple
# Edit to the live checkout. %h is the user's home.
WorkingDirectory=%h/dev-tools/software-factory
# uv lives in ~/.local/bin, which a user unit's PATH does not always carry.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/dev-tools/software-factory/.venv/bin/python -m factory serve --log-file logs/serve.log
# Exit 75 = "the checkout moved, start me on the new code"; any exit restarts.
Restart=always
RestartSec=5
# Serve drains running ticks (up to 300 s) on SIGTERM before it exits.
TimeoutStopSec=330
KillMode=mixed

[Install]
WantedBy=default.target
