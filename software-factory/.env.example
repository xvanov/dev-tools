# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------- #
# Direct providers (used when FACTORY_PROVIDER=direct or
# routes.yaml's ``default_provider: direct``).
# ---------------------------------------------------------------------- #

# Cheap, default model provider for Dev / Test-Implementer / Tech-Writer / SM
DEEPSEEK_API_KEY=

# Non-default providers — OPTIONAL. Operator decision 2026-11-02 reversed the
# 2026-07-15 "no Anthropic" rule: any persona may be routed to any provider via
# routes.yaml, apps/<app>/config.yaml::models, or a job's ``models:``
# frontmatter. Default routes stay Azure/DeepSeek. A route/override whose key
# is missing degrades to the routes.yaml fallback with a warning.
# openrouter/<vendor>/<model>
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=
# anthropic/<model>  (ANTHROPIC_BASE_URL is also accepted for the base)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=
# openai/<model>  (OPENAI_BASE_URL is also accepted for the base)
OPENAI_API_KEY=
# OPENAI_API_BASE=

# Generic OpenAI-compatible endpoint (vLLM, LM Studio, a gateway, …):
# ``openai_compat/<model>``. The base URL is REQUIRED — without it the factory
# refuses rather than sending this key to api.openai.com.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_BASE=

# Optional: override LiteLLM base_urls
# DEEPSEEK_BASE_URL=

# ---------------------------------------------------------------------- #
# Azure — TWO surfaces, pick the one your endpoint serves.
# Both default to enabled-when-set; the factory routes by model prefix in
# routes.yaml (azure_ai/<deployment> → Foundry; azure/<deployment> → OpenAI).
# ---------------------------------------------------------------------- #

# (A) Azure AI Foundry — services.ai.azure.com/models-style endpoints.
# Model ids in routes.yaml use the ``azure_ai/`` prefix.
# The factory remaps AZURE_FOUNDRY_* → AZURE_AI_API_* at startup so LiteLLM
# picks them up. You can set either set of names; the factory accepts both.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=

# Equivalent LiteLLM-named env vars for the Foundry surface (auto-populated
# from AZURE_FOUNDRY_* above unless explicitly set).
# AZURE_AI_API_BASE=
# AZURE_AI_API_KEY=
# AZURE_AI_API_VERSION=

# (B) Azure OpenAI / Cognitive Services — cognitiveservices.azure.com endpoints.
# Model ids in routes.yaml use the plain ``azure/`` prefix.
# AZURE_ENDPOINT is the operator-friendly name; the factory copies it into
# AZURE_API_BASE (the LiteLLM-standard name) at startup. AZURE_API_KEY and
# AZURE_API_VERSION already match LiteLLM's expected names — no remap.
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=

# Equivalent if you'd rather set LiteLLM-standard names directly:
# AZURE_API_BASE=

# Runtime provider override — flips routes.yaml's default without editing the
# file. Accepts "azure" or "direct".
# FACTORY_PROVIDER=azure

# --- GitHub identity (per repo owner; see factory/gh_auth.py) ---
# The token is chosen by the repo's owner, never by the active gh account.
# Default map: owner xvanov -> `gh auth token --user xvanov`; any other owner
# uses the ambient GITHUB_TOKEN/GH_TOKEN, else the active gh account.
# Add owners (a bare `owner=` removes a default entry):
# FACTORY_GH_OWNER_MAP=owner1=gh-user1,owner2=gh-user2
# Explicit override, wins for every repo (CI / PAT deployments):
# FACTORY_GITHUB_TOKEN=
# Disable the PATH shim (bin/gh) that applies this to every gh subprocess:
# FACTORY_GH_SHIM=0

# ---- factory serve (docs/WINDOWS.md) --------------------------------------
# Localhost JOBS-API port (POST /api/cli); 0 disables it.
# FACTORY_SERVE_PORT=7330
# Where job state changes are pushed (the PA's /api/factory/events); off disables.
# FACTORY_PA_EVENTS_URL=http://127.0.0.1:7300/api/factory/events
# Apps serve ticks (comma list; default: every registered app) and how often.
# FACTORY_SERVE_APPS=
# FACTORY_SERVE_INTERVAL_S=300

# --- Agent sandbox (native plan 5.2/5.3; factory/sandbox/) ---
# on: claude_session runs (and the API runtime's terminal on Linux) start in an
# OS sandbox with no GitHub credential and egress through an allowlist proxy.
# A sandbox that cannot start fails the run; it never runs unsandboxed.
# FACTORY_SANDBOX=off
# The model credential Claude Code needs inside (the one key passed on purpose):
# FACTORY_SANDBOX_PASS_ENV=CLAUDE_CODE_OAUTH_TOKEN
# Hosts added to the default allowlist (GitHub, model APIs, package registries),
# or a whole replacement list:
# SANDBOX_EGRESS_ALLOW=example.org,*.example.net
# SANDBOX_EGRESS_ALLOW_ONLY=
# Extra read-only paths for sandboxed runs (os.pathsep-separated):
# SANDBOX_READ_PATHS=
