{
  "name": "jarvisd",
  "version": "0.0.1",
  "private": true,
  "description": "Jarvis core: TypeScript on Bun (native plan 4.1). Boots the PA worker; modules move to strict TS one at a time.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p .",
    "parity": "node scripts/parity.js",
    "check": "bun src/main.ts --check",
    "build": "node ../scripts/build.js --only jarvisd",
    "test": "tsc -p . && node scripts/parity.js && bun src/main.ts --check"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
