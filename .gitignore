__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.DS_Store
Thumbs.db
# Both spellings on purpose: the trailing slash matches a real directory, the
# bare name also matches a SYMLINK to one. Agents working in git worktrees
# symlink node_modules rather than rebuild node-pty, and a symlink slips past
# the `node_modules/` form — one got committed into a branch that way.
node_modules/
node_modules
*.log

# audio / transcript artifacts
*.wav
*.mp3
*.srt
*.vtt
*.json
*.summary.md
combined-summary.md

# but keep package manifests/locks (the *.json rule above would hide them)
!package.json
!package-lock.json

# Claude Code agent worktrees — one machine-local checkout per agent, each with
# its own `.git` FILE pointing back into this repo's worktree metadata. Tracking
# one would hand every clone a dangling gitlink. Scoped to worktrees/ rather than
# all of .claude/ so shared project config (agents, skills, settings.json) can
# still be committed deliberately.
/.claude/worktrees/

# Generated voice-sample pages: one-off engine comparisons and iOS Safari
# capability harnesses, each with megabytes of base64 WAV inlined (voice-picker
# alone is 3.2 MB). Not source — the audio is regenerable from lib/tts.js, the
# conclusions already live in termhub/AGENT.md, and everything under termhub/web/
# is served on the tailnet, so these stay local.
termhub/web/voice-picker.html
termhub/web/voice-probe*.html
