# personal-assistant worker (ingest, distillation, dispatch reconciliation,
# the dashboard on 127.0.0.1:7300). A systemd *user* unit, written by
# linux/install.sh (through linux/units.js, which quotes and escapes them)
# with __DIR__ and __NODE__ filled in.
#
# Restart=always with no start limit: the worker already waits for the store
# rather than exit (src/worker.js), and a worker that gave up after five quick
# failures is how it once stayed dead for a week on Windows.

[Unit]
Description=personal-assistant worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__DIR__
ExecStart="__NODE__" "__DIR__/src/worker.js"
Restart=always
RestartSec=30
# A second worker waits on a database lock (src/worker.js); stopping must end
# node itself, which systemd does by killing the unit's whole cgroup.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
