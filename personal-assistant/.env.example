# personal-assistant configuration.
#
# Copy to `.env` in this directory (or set these as real environment variables,
# which always win). A repo-root `.env` is also read, so the Azure values shared
# with summarize-recording do not need repeating here.
#
# Nothing secret has a default: a missing value shows up in `pa doctor` as "not
# configured" rather than as a confusing 401 from a worker three layers down.

# --- the store ---------------------------------------------------------------
# Provisioned by windows/install.ps1 inside WSL. Port 5433 on purpose.
PA_DATABASE_URL=postgres://pa:pa@127.0.0.1:5433/pa

# --- Microsoft 365 -----------------------------------------------------------
# Mail, calendar and Teams come through the claude.ai Microsoft 365 connector,
# run headless with `claude -p`. No app registration and no token here: connect
# it once in Claude Code with `/mcp` -> claude.ai Microsoft 365 -> Authenticate,
# then `pa login` checks it answers. What it may read is IT's grant on the
# connector's enterprise app; `pa doctor` lists it.
# PA_M365=0 turns all three sources off.
PA_M365_POLL_SECONDS=180
# Evenings (19-08) and weekends mail and chat are polled this often instead;
# chat still arrives in seconds through the local Teams cache.
# PA_M365_OFF_HOURS_POLL_SECONDS=1800
PA_M365_CALENDAR_POLL_SECONDS=900
# The model that relays connector calls. Sonnet makes no tool calls headless
# (a silent empty pass), so test a cheaper one against a real read first.
# Claude Code only (a bare Claude name or cli/…): it is the one process that
# holds the connector logins. Any other provider is refused by `pa doctor`
# and at the call. It does not follow PA_MODEL.
# PA_CONNECTOR_MODEL=claude-opus-5

# Repos where a finished run's PR is merged once its checks pass (owner/repo or
# owner/*). Only repos you own; elsewhere a run's PR stays a draft for you.
# PA_MERGE_REPOS=innergy-dev/mv-assistant,innergy-dev/engineering-assistant,innergy-dev/mv-pipeline,innergy-dev/innergy-dispatch,xvanov/*
# Channel posts: `mentions` keeps a post only when it names you; `all` keeps
# every post in every channel you are in (many distillation calls); `off`.
PA_TEAMS_CHANNELS=mentions
# Teams in seconds: the worker also reads the new Teams client's local cache
# (README: Teams in seconds) every few seconds, so a chat lands in the store
# while you are still reading it; the connector pass backfills and upgrades.
# Local only, read-only, never logged. 0 turns it off. Needs the teams-venv
# that install.ps1 creates; without it this is a no-op that `pa doctor` names.
PA_TEAMS_CACHE=1
# PA_TEAMS_CACHE_POLL_SECONDS=5

# --- GitHub ------------------------------------------------------------------
# No token: ingest runs through the signed-in `gh` CLI. Project boards need
# `gh auth refresh -s read:project`. PA_GITHUB_ORGS limits which orgs' boards
# are read (default: every org you belong to).
PA_GITHUB=1
# PA_GITHUB_ORGS=innergy-dev
# Follow a pod's board by a field value, not by assignee: org/number:Field=Value.
# PA_GITHUB_BOARDS=innergy-dev/7:Pod=Xi
PA_GITHUB_POLL_SECONDS=300

# --- Jira --------------------------------------------------------------------
# Preferred: Jira's REST API with an API token. The token is a secret and does
# NOT go here — the dashboard asks for it (Needs you) and stores it in Windows
# Credential Manager, or run `pa secret set PA_JIRA_API_TOKEN`. Create one at
# https://id.atlassian.com/manage-profile/security/api-tokens
# Without a token, a headless `claude -p` relays JQL results from the claude.ai
# Atlassian connector (/mcp -> claude.ai Atlassian MCP).
PA_JIRA=1
# The Atlassian account the token belongs to. Default: your Microsoft 365 address.
# PA_JIRA_EMAIL=you@example.com
# `acme` or https://acme.atlassian.net. Default: the site the connector found.
# PA_JIRA_SITE=
# PA_JIRA_CLOUD_ID=
PA_JIRA_POLL_SECONDS=900

# --- distillation ------------------------------------------------------------
# The layer that turns messages into typed commitments. Optional: without a
# key, model calls run through a headless `claude -p` on your own Claude Code
# login. PA_CLAUDE_BIN overrides which `claude` that is.
ANTHROPIC_API_KEY=
# PA_CLAUDE_BIN=claude
# Run pa's own `claude -p` on a login of its own, so it stays on one
# subscription while you switch yours. A Claude Code config folder: sign it in
# once with  $env:CLAUDE_CONFIG_DIR='<folder>'; claude  then /login and /mcp
# (connect Microsoft 365 there). Agent runs dispatched through termhub are not
# affected: they use the login of the machine they run on. `pa doctor` shows
# which account is in use on its `claude login` line.
# PA_CLAUDE_CONFIG_DIR=~/.claude-pa
# The cost lever here is effort, not a smaller model: extraction quality is what
# the whole tool is made of, and a cheap wrong commitment costs more attention
# than it saves in tokens.
PA_DISTILL_MODEL=claude-opus-5
PA_DISTILL_EFFORT=low

# --- model providers ---------------------------------------------------------
# Every *_MODEL variable takes a model string (README: Models and providers):
#   claude-sonnet-5-5           bare: the API with ANTHROPIC_API_KEY, else claude -p
#   anthropic/claude-sonnet-5-5 the Anthropic API, always
#   cli/claude-opus-5           headless claude -p, always
#   azure/<deployment>          Azure OpenAI (AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY below)
#   openai/<model>  openrouter/<vendor>/<model>  deepseek/<model>  local/<model>
# PA_MODEL is the default for every pass without its own variable (not the
# connector relay). Per pass: PA_DISTILL_MODEL, PA_MEMORY_EXTRACT_MODEL,
# PA_MEMORY_DECIDE_MODEL, PA_MEMORY_PAGE_MODEL, PA_BRIEF_MODEL,
# PA_BRIEF_CLASSIFY_MODEL, PA_DEBRIEF_MODEL, PA_REPLY_CLOSE_MODEL,
# PA_RECONCILE_MODEL, PA_CARD_CONTEXT_MODEL, PA_PLANNER_MODEL, PA_DRAFT_MODEL,
# PA_ROUTINE_MODEL, PA_EVAL_MODEL. `pa doctor` prints one line per pass.
# PA_MODEL=
# Keys are secrets: set them with `pa secret set <NAME>` (or here).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# Any OpenAI-compatible server; a key only if it wants one.
# PA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# PA_LOCAL_LLM_API_KEY=
# Azure chat models on another resource than the embeddings one. `v1` is the
# version-less API (works for Azure OpenAI and Foundry deployments); a dated
# version uses the per-deployment route.
# PA_AZURE_CHAT_ENDPOINT=
# PA_AZURE_CHAT_API_VERSION=v1
# Prices pa does not know, dollars per million tokens in:out. Without one a
# non-Claude call's cost is recorded as unknown, never guessed (OpenRouter
# reports its own).
# PA_MODEL_PRICES=azure/gpt-5.4=1.25:10,deepseek/deepseek-chat=0.28:0.42

# An owed_by_me ask from Teams or mail is closed once my own later reply in
# the same thread settles it, with that reply's words as the reason (undo:
# `pa done <id> --reopen`). PA_REPLY_CLOSE=0 turns the worker pass off.
PA_REPLY_CLOSE=1
# PA_REPLY_CLOSE_MODEL=claude-sonnet-5-5
# PA_REPLY_CLOSE_EFFORT=low

# --- memory ------------------------------------------------------------------
# Claims about people and projects, each with the verbatim quote it came from,
# consolidated into pages (`pa memory`). Many small judgements, so cheaper
# models than distillation. PA_MEMORY=0 turns the worker passes off.
PA_MEMORY=1
# PA_MEMORY_EXTRACT_MODEL=claude-sonnet-5-5
# PA_MEMORY_DECIDE_MODEL=claude-sonnet-5-5
# PA_MEMORY_PAGE_MODEL=claude-sonnet-5-5
# How many items/commitments/claims before a person gets a page.
# PA_MEMORY_MIN_INTERACTIONS=4
# Local hour after which the nightly consolidation ("dream") may run.
# PA_MEMORY_DREAM_HOUR=2

# --- embeddings (optional) ---------------------------------------------------
# Azure OpenAI, shared with summarize-recording. Without it, search is full-text
# only — good on names and ids, weaker on paraphrase. `pa doctor` probes this
# rather than trusting that it is set, because a wrong deployment name looks
# exactly like a working one until half your results quietly go missing.
# text-embedding-3-large with dimensions=1536 fits the vector(1536) column; on
# mv-triage-foundry (the repo-root endpoint) that is the only embedding model.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
PA_EMBED_DEPLOYMENT=text-embedding-3-large
PA_EMBED_DIMENSIONS=1536
# Cohere Rerank on the same resource (see SETUP.md step 3). Off with PA_RERANK=0.
# PA_RERANK_DEPLOYMENT=cohere-rerank-v4-fast
# PA_RERANK_CANDIDATES=40

# --- dispatch ----------------------------------------------------------------
# termhub is the session substrate: it is the only one you can attach to from a
# phone. Runs get their own git worktree, never your main checkout.
PA_TERMHUB_URL=http://127.0.0.1:7000
PA_CLAUDE_COMMAND=claude --dangerously-skip-permissions
# The agent a run starts: claude (PA_CLAUDE_COMMAND) or opencode (started as
# `opencode --auto`, its providers set up in opencode itself). Per run:
# `pa do … --agent opencode --model azure/gpt-5.4`. Local runs only.
# PA_DISPATCH_AGENT=claude
# PA_DISPATCH_MODEL=
# The PA chat (`pa chat`): claude or opencode, and its model. Never with
# permissions skipped — `pa chat` and `pa doctor` refuse a command that does.
# An opencode chat starts only after opencode confirms the permission rules
# pa wrote for it. PA_CHAT_COMMAND replaces the whole command line.
# PA_CHAT_AGENT=claude
# PA_CHAT_MODEL=
# PA_CHAT_COMMAND=
PA_REPOS_ROOT=C:\repos
# PA_WORKTREES_ROOT defaults to %LOCALAPPDATA%\personal-assistant\worktrees
# Other machines a run can go to (`pa do <id> --machine name`, or the machine
# picker beside Do): name=termhubUrl|reposRoot[|os], comma-separated. The repo
# must be cloned there under the same folder name. os is windows, linux or
# macos; omitted, termhub's reported platform decides. Setup runs through that
# termhub's POST /api/exec — update termhub there if `pa doctor` says it is too
# old. Claude sessions on these machines are also ingested, every 5 minutes,
# through their termhub (needs /api/claude/transcripts).
# PA_MACHINES=build-vm=http://build-vm.your-tailnet.ts.net:7000|C:\source,lab=http://lab.your-tailnet.ts.net:7000|/home/me/repos|linux

# The software factory as a second dispatch target (`pa do <id> --via factory`).
# Off until PA_FACTORY_PATH names its checkout, as a path on the factory's
# machine. PA_FACTORY_MACHINE is a PA_MACHINES name (its termhub hosts the
# "follow the job" session), or empty for this machine.
# PA_FACTORY_PATH=/home/you/software-factory
# PA_FACTORY_MACHINE=
# Default route for `pa do` without --via: claude | factory | auto.
# PA_DISPATCH_VIA=claude
# PA_FACTORY_PIPELINE=auto
# Per-persona model overrides sent with every job: persona=model, comma-separated.
# PA_FACTORY_MODELS=
# The mode a planner "send to the factory?" card offers (mr = at most a draft PR).
# PA_FACTORY_PROPOSAL_MODE=mr
# How --via auto chooses (src/dispatch/route.js CHOOSERS).
# PA_ROUTE_CHOOSER=rule
# PA_FACTORY_POLL_SECONDS=120

# --- always-on capture -------------------------------------------------------
PA_AUDIO_ENABLED=1
# voice-dictation's faster-whisper server, reused rather than installed twice.
PA_TRANSCRIBE_HOST=127.0.0.1
PA_TRANSCRIBE_PORT=47821
PA_AUDIO_ROLL_MINUTES=15
PA_AUDIO_EPISODE_GAP_SECONDS=90
# Record during meetings only: calendar meetings, plus any call that has
# another app on the microphone. 0 = always-on.
PA_AUDIO_MEETING_GATE=1
# Which mic is "you": the first whose name matches, else the default device.
# PA_AUDIO_MIC=headset|hands-free
# PA_AUDIO_GATE_POLL_SECONDS=20
# PA_AUDIO_GATE_LEAD_MINUTES=2
# PA_AUDIO_GATE_GRACE_MINUTES=5
# PA_AUDIO_GATE_CALL_GRACE_SECONDS=120

# --- retention ---------------------------------------------------------------
# Raw mail and chat bodies age out; distilled rows do not. Raw PCM is deleted
# every cycle once trimmed.
PA_RETENTION_RAW_DAYS=180
PA_RETENTION_RAW_AUDIO_HOURS=6

# PA_LOG_LEVEL=debug

# --- backup --------------------------------------------------------------------
# Nightly pg_dump of the whole store. The dumps contain everything the assistant
# knows — keep them on a disk only you can read.
# PA_BACKUP_DIR=
# PA_BACKUP_KEEP=14
# PA_WSL_DISTRO=Ubuntu

# --- routines ------------------------------------------------------------------
# Recurring typed actions (pa routine). 0 stops the worker running them on
# schedule; `pa routine run <id>` still works by hand.
# PA_ROUTINES=1
# Local hour after which the nightly "suggest a routine" pass runs.
# PA_ROUTINE_SUGGEST_HOUR=3
